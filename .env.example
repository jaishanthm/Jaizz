# Copy to .env (never commit .env). Fill in real values locally / in Vercel project settings.

# Database (Neon or equivalent — pooled + direct, per Phase 8 §1)
DATABASE_URL=
DIRECT_URL=

# NextAuth
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# Bootstrap seed — only used locally by prisma/seed.ts, never read at runtime by the app
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# One-time Mongo migration only (scripts/migrate-from-mongo.ts) — not used
# by the app itself, safe to leave blank until you actually run that script
MONGODB_URI=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upstash Redis (rate limiting — Stage 7). If left blank, rate limiting is
# skipped rather than the app crashing — see src/lib/rate-limit.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
